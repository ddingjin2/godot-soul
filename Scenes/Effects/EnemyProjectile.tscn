; A caster's shot, instanced by EnemyProjectilePool. Replaces the detached template
; GameplayEnemySpawner.CreateProjectilePrefab used to build and Duplicate().
;
; UNITS: 1 Unity metre = 100 px (World.Ppu). Every literal below is the converted pixel value; the
; metre value it came from is named in the comment beside it. Nothing re-scales these at runtime.
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Enemy/EnemyProjectile.cs" id="1"]
[ext_resource type="Texture2D" path="res://Resources/Art/Disc.png" id="2"]

[sub_resource type="CircleShape2D" id="CircleShape2D_hit"]
; World.U(0.3f) - 0.3 m contact radius, as EnemyProjectile._Ready used to build it.
radius = 30.0

[node name="EnemyProjectile" type="Node2D"]
script = ExtResource("1")

[node name="Sprite" type="Sprite2D" parent="."]
; Disc.png is 64x64. World.U(0.42f) = 42 px square -> 42/64 = 0.65625.
; GameplayVisualFactory.Pivot(SpriteKind.Disc) is (0.5, 0.5), which is Sprite2D's own centring, so
; there is no offset to author.
scale = Vector2(0.65625, 0.65625)
; GameplayReadabilityDefaults.ProjectileColor / ProjectileSortingOrder as shipped. The spawner
; overwrites both from readability, so Resources/Art/Readability.json still wins at runtime; these
; are what a caster nobody wired gets.
modulate = Color(0.86, 0.42, 1, 1)
z_index = 10
texture = ExtResource("2")

[node name="HitArea" type="Area2D" parent="."]
; World.Layer.EnemyHitbox = 1 << 5 = 32.
collision_layer = 32
; World.Layer.Player (1 << 1) | World.Layer.Ground (1 << 3) = 2 | 8 = 10.
collision_mask = 10

[node name="CollisionShape2D" type="CollisionShape2D" parent="HitArea"]
shape = SubResource("CircleShape2D_hit")
