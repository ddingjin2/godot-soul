; The burning ground a boss attack leaves behind, instanced by RainbowChapterBossBehaviour.
; Replaces the template GameplayEnemySpawner.CreateHazardPrefab parented to the boss and Duplicate()d.
;
; Colour and size are NOT authored here: BossAttackProfile owns HazardColor and HazardRadius, and the
; boss dresses the sprite from them the moment it drops a strip.
[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Enemy/BossHazardStrip.cs" id="1"]
[ext_resource type="Texture2D" path="res://Resources/Art/Disc.png" id="2"]

[node name="BossHazardStrip" type="Node2D"]
script = ExtResource("1")

[node name="Sprite" type="Sprite2D" parent="."]
; GameplayReadabilityDefaults.EnemyReadoutSortingOrder = 3: above the floor, under the actors
; standing on it, which is where a danger marker on the ground belongs.
z_index = 3
; Scale is left at 1 on purpose - the template was dressed with Vector2.Zero, meaning "1:1 until
; someone sizes me". SetSpriteSize(HazardRadius * 2) does that per strip.
texture = ExtResource("2")
