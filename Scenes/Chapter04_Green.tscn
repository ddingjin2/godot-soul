; A chapter shell. Everything it is - the bootstrap script, the camera rig, the hit stop manager, the
; cutscene director and the enemy respawner - is inherited from Scenes/World/GameplayShell.tscn, the
; same way Scenes/TitleScene.tscn inherits Scenes/UI/TitleScreen.tscn. Eight byte-identical copies of
; that tree would be rule 2's "copied node tree"; this is one line instead.
;
; What makes this chapter this chapter is its NAME: GameplayBuildShim.ActiveSceneName is the base name
; of CurrentScene.SceneFilePath, and GameplaySceneDefaults.CreateForScene reads
; Resources/Design/SceneLayout_<that name>.json. Renaming the file moves the arena.
[gd_scene load_steps=2 format=3]

[ext_resource type="PackedScene" path="res://Scenes/World/GameplayShell.tscn" id="1_shell"]

[node name="GameplayRoot" instance=ExtResource("1_shell")]
