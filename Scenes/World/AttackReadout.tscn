; The translucent disc that shows where an attack will land - the player's swing arc and every
; enemy's danger zone. Replaces two verbatim-identical builders, GameplayPlayerSpawner
; .CreateAttackReadout and GameplayEnemySpawner.CreateAttackReadout; nothing differed between them.
; Name, local position, size, colour and sorting order all vary per readout and stay bound.
;
; This scene is deliberately NOT merged with MarkerDisc.tscn. Here the pulse is the child of the
; sprite; there it is the parent. GameplayTelegraphPulse caches the colour and the scale it finds
; when it is readied, so swapping the two is a behaviour change, not a refactor.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu). Disc.png is 64x64 and every size below is the converted
; pixel value divided by that, with the metre value it came from named beside it.
[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Gameplay/GameplayTelegraphPulse.cs" id="2"]
[ext_resource type="Texture2D" path="res://Resources/Art/Disc.png" id="1"]

[node name="AttackReadout" type="Sprite2D"]
; GameplayVisualFactory.Pivot(SpriteKind.Disc) is (0.5, 0.5), which is Sprite2D's own centring, so
; there is no offset to author.
texture = ExtResource("1")
; GameplayReadabilityDefaults.AttackArcSize = World.U(1.05, 0.75) = 105x75 px -> /64.
; Every spawner binds its own size over this (MeleeDangerSize, BossSlamDangerSize, ...).
scale = Vector2(1.640625, 1.171875)
; PlayerAttackReadoutColor as shipped. Designer-owned via Resources/Art/Readability.json, so the
; spawner overwrites it; this is what a readout nobody wired gets.
modulate = Color(0.82, 0.9, 1, 0.16)
; PlayerReadoutSortingOrder = 8. Enemies bind EnemyReadoutSortingOrder = 3 and the boss 4 / 2.
z_index = 8

[node name="GameplayTelegraphPulse" type="Node2D" parent="."]
; Named for the type, because GameplayBuildShim.AddComponent<T>() named it that and
; NodeExt.GetComponent<T>() reads the tree back by type. Its own scale stays 1: the sprite above
; carries the size, and the pulse caches this scale when it is readied.
script = ExtResource("2")
