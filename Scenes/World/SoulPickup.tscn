; The souls the player dropped where they died, waiting to be walked over. Replaces the tree
; SoulPickup.Create used to build node by node; Create now instances this, binds `souls` and the
; pickup delay, and still writes the position BEFORE the node enters the tree - a body added at the
; origin and moved afterwards sweeps from the origin on its first physics step (see CLAUDE.md).
;
; The telegraph pulse is reused so the stain reads as something to walk into, not scenery. The sprite
; hangs under the pulse, as in MarkerDisc.tscn, because the pulse caches the scale it finds at _Ready
; and the sprite is what carries the size.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu). Disc.png is 64x64.
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Gameplay/SoulPickup.cs" id="1"]
[ext_resource type="Script" path="res://Scripts/Gameplay/GameplayTelegraphPulse.cs" id="2"]
[ext_resource type="Texture2D" path="res://Resources/Art/Disc.png" id="3"]

[sub_resource type="CircleShape2D" id="CircleShape2D_reach"]
; 0.6 m reach -> World.U -> 60 px.
radius = 60.0

[node name="SoulPickup" type="Area2D"]
; World.Layer.Trigger = 1 << 6 = 64, mask World.Layer.Player = 1 << 1 = 2.
collision_layer = 64
collision_mask = 2
script = ExtResource("1")

[node name="Reach" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_reach")

[node name="Pulse" type="Node2D" parent="."]
script = ExtResource("2")

[node name="Stain" type="Sprite2D" parent="Pulse"]
texture = ExtResource("3")
; 0.55 m disc -> World.U -> 55 px across, / 64 = 0.859375.
scale = Vector2(0.859375, 0.859375)
; The stain's own colour - a literal of SoulPickup's, not part of the designer palette.
modulate = Color(0.5176471, 0.57254902, 0.627451, 0.85)
z_index = 40
