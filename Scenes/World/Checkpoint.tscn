; A bonfire: the respawn marker the death loop reads, and the zone the player rests at, on one
; object. Replaces GameplayEnvironmentBuilder.CreateCheckpointAt and CheckpointZone.EnsureTrigger's
; construction branch, and instances Scenes/World/MarkerDisc.tscn for the pulsing disc rather than
; building a second copy of it.
;
; The root Node2D and its first child are both called "Checkpoint" - names only have to be unique
; among siblings. That is the shape the runtime builder made (a bare object carrying a Checkpoint
; component and a CheckpointZone component, Unity's two-components-on-one-GameObject) and
; P0CombatStabilityTests reads it back with GetComponent<Checkpoint>(), which looks at direct
; children.
;
; WHAT IS BOUND PER INSTANCE: the root's name and position and the zone's checkpoint index (the
; builder, from SceneLayout_*.json), the checkpoint id (the builder), the trigger radius
; (WorldTuning.json via CheckpointZone.AuthoredRadius) and the marker's colour and size
; (Readability.json via CheckpointZone.EnsureMarker). The builder binds all of them while the
; instance is still detached, because GameplayTelegraphPulse caches the colour it finds at _Ready and
; writes it back every frame afterwards.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu).
[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Gameplay/Checkpoint.cs" id="1"]
[ext_resource type="Script" path="res://Scripts/Gameplay/CheckpointZone.cs" id="2"]
[ext_resource type="PackedScene" path="res://Scenes/World/MarkerDisc.tscn" id="3"]

[sub_resource type="CircleShape2D" id="CircleShape2D_trigger"]
; Local to the scene so a chapter's several bonfires do not share one shape resource.
resource_local_to_scene = true
; WorldTuning.json checkpointZoneRadius = 1.5 m -> World.U -> 150 px. Rebound from the design file
; on every instance; a zone with no catalog reports an error and keeps this shape (K5).
radius = 150.0

[node name="Checkpoint" type="Node2D"]

[node name="Checkpoint" type="Node2D" parent="."]
; checkpointId and respawnOffset are written by Checkpoint.Configure. The offset is zero for every
; shipped bonfire - the respawn is the zone itself - and it is in Godot pixels when it is not.
script = ExtResource("1")

[node name="CheckpointZone" type="Area2D" parent="."]
; World.Layer.Trigger = 1 << 6 = 64, watching World.Layer.Player = 1 << 1 = 2. Godot's BodyEntered
; only ever reports solid bodies, so Unity's "ignore trigger colliders" filter is the engine's job.
collision_layer = 64
collision_mask = 2
script = ExtResource("2")

[node name="Trigger" type="CollisionShape2D" parent="CheckpointZone"]
shape = SubResource("CircleShape2D_trigger")

; MarkerDisc.tscn ships with CheckpointLabelColor and a 1.5 m disc already, so this instance needs no
; override - the gate portal is the one that retints it. The name is what CheckpointZone.EnsureMarker
; looks for, so a scene-built zone is recognised instead of getting a second marker.
[node name="CheckpointZoneMarker" parent="CheckpointZone" instance=ExtResource("3")]
