; The portal back down the road, parked beside the checkpoint. Replaces
; GameplayEnvironmentBuilder.CreateGatePortal and GateTravelZone.EnsureTrigger's construction branch,
; and instances Scenes/World/MarkerDisc.tscn - the same disc the bonfire uses, tinted the arena-gate
; colour so it reads as a gate and not as a second bonfire. That tint was the only thing that ever
; differed between the two markers.
;
; Shaped like Checkpoint.tscn on purpose: a bare Node2D carrying the zone, which is Unity's
; "component on a GameObject" as this port expresses it.
;
; WHAT IS BOUND PER INSTANCE: the root's position (the builder, GatePortalOffsetX beside the
; checkpoint) and the marker's colour and size (Readability.json via GateTravelZone.EnsureMarker,
; bound while the instance is detached because GameplayTelegraphPulse caches the colour at _Ready).
; THE TRIGGER RADIUS IS AUTHORED HERE AND NOWHERE ELSE. Unlike the bonfire's, which WorldTuning.json
; owns through checkpointZoneRadius, there is no design key for the gate's reach - so this scene
; property is the single source, which rule 1 allows as a data asset. K7 deleted the 1.4 m constant
; that used to sit beside it in GateTravelZone; EnsureMarker now sizes the disc FROM this number.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu).
[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Gameplay/GateTravelZone.cs" id="1"]
[ext_resource type="PackedScene" path="res://Scenes/World/MarkerDisc.tscn" id="2"]

[sub_resource type="CircleShape2D" id="CircleShape2D_trigger"]
resource_local_to_scene = true
; 1.4 m -> World.U -> 140 px. Smaller than the bonfire's 1.5 m so the two can share a corner of the
; arena without both answering the same Interact.
radius = 140.0

[node name="GatePortal" type="Node2D"]

[node name="GateTravelZone" type="Area2D" parent="."]
; World.Layer.Trigger = 1 << 6 = 64, watching World.Layer.Player = 1 << 1 = 2.
collision_layer = 64
collision_mask = 2
script = ExtResource("1")

[node name="Trigger" type="CollisionShape2D" parent="GateTravelZone"]
shape = SubResource("CircleShape2D_trigger")

; The name GateTravelZone.EnsureMarker looks for, so a scene-built portal is recognised rather than
; given a second marker.
[node name="GateTravelZoneMarker" parent="GateTravelZone" instance=ExtResource("2")]

[node name="Disc" parent="GateTravelZone/GateTravelZoneMarker" index="0"]
; MarkerDisc.tscn ships the bonfire's 1.5 m disc; this is the portal's 1.4 m one.
; World.U(1.4) = 140 px radius -> 280 px across, / 64 (Disc.png) = 4.375.
scale = Vector2(4.375, 4.375)
; GameplayReadabilityDefaults.ArenaGateColor as shipped, over MarkerDisc's CheckpointLabelColor.
; Readability.json still wins at runtime.
modulate = Color(0.2, 0.1882353, 0.16862746, 1)
