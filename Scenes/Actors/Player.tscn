; The player. Replaces GameplayPlayerSpawner.BuildPlayer and CreatePlayerSword; what stays in the
; spawner is the tuning and, far more importantly, the ORDER of it.
;
; SHAPE: Unity put a dozen components on one GameObject. Here the actor root is the PlayerMotor2D -
; the port made the motor the CharacterBody2D - and every other component is a child node of it,
; which is the arrangement NodeExt.GetComponent and PlayerShim.Get read back. The Unity player was a
; Rigidbody2D with freezeRotation, interpolation and Continuous collision; a CharacterBody2D never
; rotates, is interpolated by the engine and resolves its own sweep in MoveAndSlide, so none of the
; three has a property to author.
;
; THREE TRAPS SURVIVE THIS SCENE AND ARE NOT FIXED BY IT. Read them before editing:
;
;  1. PlayerController2D._Ready deliberately re-runs actions.Initialize with *its own* exported
;     damageHitbox, which is null. So `damageHitbox`, `hitboxAnchor`, `visual`, `motor`, `actions`
;     and the rest of that node's exports are LEFT UNSET below on purpose. Wiring them here would
;     "fix" a trap CLAUDE.md says explicitly not to fix, and the spawner's
;     player.SetDamageHitbox(hitbox) after the player is in the tree is what puts the hitbox back.
;  2. "ReadableSword" is coupled by name from production code:
;     ActorAnimationDriver.VectorSwordName and GameplayPlayerSpawner's
;     hitbox.GetNode("ReadableSword"). PlayerAttackAnimator2D's method track hides descendant
;     Sprite2Ds under a node with that name. Renaming it breaks the swing silently.
;  3. Child order is load-bearing for the two type lookups that can be ambiguous: the spawner's
;     go.GetComponent<Sprite2D>() and ActorAnimationDriver both take the first direct Sprite2D child
;     of the root, so Visual must stay the only Sprite2D at root level - the sword and the arc live
;     under HitboxAnchor, where they cannot be mistaken for the body.
;
; WHAT IS STILL BOUND AT RUNTIME: PlayerResourceData / PlayerMovementData / PlayerCombatData /
; SinTuning / WorldTuning from Resources/Design, the fall-death Y and the spawn position from
; GameplaySceneDefaults, the hitbox radius and offset and every colour from
; GameplayReadabilityDefaults with Resources/Art/Readability.json over it. So each literal below is
; the shipped default a player nobody tuned would get.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu), +Y down.
[gd_scene load_steps=21 format=3]

[ext_resource type="Script" path="res://Scripts/Player/PlayerMotor2D.cs" id="1"]
[ext_resource type="Texture2D" path="res://Resources/Art/ActorPlayer.png" id="2"]
[ext_resource type="Script" path="res://Scripts/Combat/Health.cs" id="3"]
[ext_resource type="Script" path="res://Scripts/Player/StaminaSystem.cs" id="4"]
[ext_resource type="Script" path="res://Scripts/Combat/Poise.cs" id="5"]
[ext_resource type="Script" path="res://Scripts/Combat/SoulsWallet.cs" id="6"]
[ext_resource type="Script" path="res://Scripts/Combat/CombatFeedback.cs" id="7"]
[ext_resource type="Script" path="res://Scripts/Combat/AudioFeedback.cs" id="8"]
[ext_resource type="Script" path="res://Scripts/Combat/DamageHitbox2D.cs" id="9"]
[ext_resource type="Texture2D" path="res://Resources/Art/Sword.png" id="10"]
[ext_resource type="Script" path="res://Scripts/Player/PlayerAttackAnimator2D.cs" id="11"]
[ext_resource type="PackedScene" path="res://Scenes/World/AttackReadout.tscn" id="12"]
[ext_resource type="Script" path="res://Scripts/Player/PlayerActionController.cs" id="13"]
[ext_resource type="Script" path="res://Scripts/Player/PlayerController2D.cs" id="14"]
[ext_resource type="Script" path="res://Scripts/Combat/HumanityController.cs" id="15"]
[ext_resource type="Script" path="res://Scripts/Combat/SinResonanceController.cs" id="16"]
[ext_resource type="Script" path="res://Scripts/Gameplay/PlayerInputReceiver.cs" id="17"]
[ext_resource type="Script" path="res://Scripts/Gameplay/GameplayFallDeath.cs" id="18"]
[ext_resource type="Script" path="res://Scripts/Gameplay/GameplayWorldHealthBar.cs" id="19"]
[ext_resource type="PackedScene" path="res://Scenes/World/WorldHealthBar.tscn" id="20"]
[ext_resource type="Script" path="res://Scripts/Player/DeathStateController.cs" id="21"]
[ext_resource type="Script" path="res://Scripts/Gameplay/DebugVisualization.cs" id="22"]
[ext_resource type="Script" path="res://Scripts/Gameplay/GameplaySoulDrop.cs" id="23"]

[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_body"]
; Local to the scene, so a second player - a test fixture, a spirit-form double - cannot resize the
; first one's body. PlayerColliderSize = World.U(0.58, 1.28) = 58 x 128 px; Unity's
; CapsuleCollider2D.size was the full width and height and Godot wants a radius, hence 58 / 2.
resource_local_to_scene = true
radius = 29.0
height = 128.0

[node name="Player" type="CharacterBody2D"]
; World.Layer.Player = 1 << 1 = 2.
collision_layer = 2
; World.Layer.GroundProbe (World 1 << 0 | Ground 1 << 3 = 9) | World.Layer.Enemy (1 << 2 = 4) = 13.
; Drop World or Ground out of this and the player stands on nothing.
collision_mask = 13
script = ExtResource("1")

[node name="Collider" type="CollisionShape2D" parent="."]
shape = SubResource("CapsuleShape2D_body")

[node name="Visual" type="Sprite2D" parent="."]
texture = ExtResource("2")
; GameplayVisualFactory.Pivot(ActorSpriteKind) is (0.5, 0.45) measured from the texture's
; bottom-left, and Dress turned that into ((0.5 - 0.5) * 64, (0.45 - 0.5) * 128) = (0, -6.4) on the
; 64 x 128 ActorPlayer.png. Feet-heavy, not centred.
centered = true
offset = Vector2(0, -6.4)
; PlayerVisualSize = World.U(0.9, 1.45) = 90 x 145 px, / the 64 x 128 texture.
scale = Vector2(1.40625, 1.1328125)
; GameplayReadabilityDefaults.PlayerColor as shipped; Readability.json still wins at runtime, and
; CombatFeedback caches whatever it finds as the colour to flash back to.
modulate = Color(0.68235296, 0.72156864, 0.7607843, 1)
; PlayerSortingOrder = 10.
z_index = 10

[node name="Health" type="Node" parent="."]
script = ExtResource("3")

[node name="StaminaSystem" type="Node" parent="."]
script = ExtResource("4")

[node name="Poise" type="Node" parent="."]
script = ExtResource("5")

[node name="SoulsWallet" type="Node" parent="."]
script = ExtResource("6")

[node name="CombatFeedback" type="Node2D" parent="."]
script = ExtResource("7")

[node name="AudioFeedback" type="Node" parent="."]
script = ExtResource("8")

; AudioFeedback.Play looks for this by type before creating one, so an authored player never builds
; it at runtime. One AudioStreamPlayer plays one stream: a cue landing while another is still ringing
; cuts it off rather than layering. Add a second AudioFeedback + AudioStreamPlayer pair if that ever
; matters.
[node name="AudioSource" type="AudioStreamPlayer" parent="AudioFeedback"]

; One node, not two: the anchor and the damage volume were the same GameObject in Unity, and
; DamageHitbox2D is an Area2D. It runs its own overlap query every frame rather than reading signals,
; so it needs no CollisionShape2D of its own - the radius Configure is handed is the query.
; PlayerHitboxAnchorLocalPosition = World.V(0.4, 0) = (40, 0).
[node name="HitboxAnchor" type="Area2D" parent="."]
position = Vector2(40, 0)
; World.Layer.PlayerHitbox = 1 << 4 = 16, watching World.Layer.Enemy = 1 << 2 = 4.
collision_layer = 16
collision_mask = 4
script = ExtResource("9")

; THE NAME IS AN API. See trap 2 in the header before renaming it.
; Unity had one GameObject carrying the sprite, the Animator and PlayerAttackAnimator2D; here the
; sprite is the node and the animator pair hangs under it, because PlayerAttackAnimator2D finds its
; AnimationPlayer among its own children.
; SwordLocalPosition = World.V(0.12, 0.22) = (12, -22) - up and forward of the anchor, and +Y is
; down, so a Unity +0.22 is negative here.
[node name="ReadableSword" type="Sprite2D" parent="HitboxAnchor"]
position = Vector2(12, -22)
; SwordLocalRotation: Unity authored euler z = -28 degrees, and the sign flips with the Y axis, so
; this is Mathf.DegToRad(28) = 0.48869219.
rotation = 0.48869219
texture = ExtResource("10")
; GameplayVisualFactory.Pivot(SpriteKind.Sword) is (0.1, 0.5): the blade turns about its hilt, not
; its middle. On the 96 x 24 Sword.png that is ((0.5 - 0.1) * 96, (0.5 - 0.5) * 24) = (38.4, 0).
centered = true
offset = Vector2(38.4, 0)
; SwordSize = World.U(0.95, 0.22) = 95 x 22 px, / the 96 x 24 texture.
scale = Vector2(0.98958331, 0.91666667)
; GameplayReadabilityDefaults.SwordColor as shipped; Readability.json still wins at runtime.
modulate = Color(0.5568628, 0.54901963, 0.50980395, 1)
; SwordSortingOrder = 12 - in front of the body, which is 10.
z_index = 12

[node name="PlayerAttackAnimator2D" type="Node2D" parent="HitboxAnchor/ReadableSword"]
script = ExtResource("11")

; Unity loaded a RuntimeAnimatorController asset here. There is no swing clip in this port yet, so
; the AnimationPlayer is authored empty: PlayerAttackAnimator2D checks HasAnimation before it plays,
; so an empty player is silent rather than broken, and dropping a clip named "Attack" into it is all
; this needs later. The `animator` export stays unset - the spawner hands this node over explicitly.
[node name="AnimationPlayer" type="AnimationPlayer" parent="HitboxAnchor/ReadableSword/PlayerAttackAnimator2D"]

; The player's swing arc - the same scene every enemy danger disc uses. AttackReadout.tscn already
; ships AttackArcSize, PlayerAttackReadoutColor and PlayerReadoutSortingOrder, and
; AttackArcLocalPosition is Vector2.Zero, so this instance overrides nothing. The spawner rebinds the
; colour anyway, because it is designer-owned.
[node name="AttackArc" parent="HitboxAnchor" instance=ExtResource("12")]

[node name="PlayerActionController" type="Node2D" parent="."]
script = ExtResource("13")

; PlayerStateMachine is plain logic in this port, not a node - PlayerController2D owns one directly,
; so there is nothing to author for it. Every [Export] on this node is left null deliberately; see
; trap 1 in the header.
[node name="PlayerController2D" type="Node2D" parent="."]
script = ExtResource("14")

[node name="HumanityController" type="Node" parent="."]
script = ExtResource("15")

[node name="SinResonanceController" type="Node" parent="."]
script = ExtResource("16")

[node name="PlayerInputReceiver" type="Node" parent="."]
script = ExtResource("17")

[node name="GameplayFallDeath" type="Node2D" parent="."]
script = ExtResource("18")

[node name="GameplayWorldHealthBar" type="Node2D" parent="."]
script = ExtResource("19")

; GameplayWorldHealthBar.Build looks for a child named exactly "HealthBar" and only instances this
; scene when it finds none - so the authored bar is the one that gets used. Size, offset and colour
; are rewritten by ApplyLayout from what AddHealthBar is handed.
[node name="HealthBar" parent="GameplayWorldHealthBar" instance=ExtResource("20")]
; PlayerHealthBarOffset = World.V(0, 1.24) = (0, -124).
position = Vector2(0, -124)

[node name="DeathStateController" type="Node2D" parent="."]
script = ExtResource("21")

[node name="DebugVisualization" type="Node2D" parent="."]
script = ExtResource("22")

[node name="GameplaySoulDrop" type="Node2D" parent="."]
script = ExtResource("23")
