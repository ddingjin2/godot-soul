; Everything every enemy in this game has, and nothing any one archetype has on its own. The four
; shipped archetypes and both bosses inherit this scene and add their own readouts on top, which is
; what the four Create*At methods in GameplayEnemySpawner used to write out longhand four times over.
;
; SHAPE: the port made EnemyStateMachine the CharacterBody2D, so the behaviour *is* the actor root
; and every other component is a child node of it - the arrangement NodeExt.GetComponent and
; EnemyShim.FindComponent read back. This base carries no script: EnemyStateMachine is abstract, so
; the script arrives with the inheriting scene (MeleeGrunt.tscn, ChapterBoss.tscn, ...).
;
; CHILD ORDER IS LOAD-BEARING. FindComponent<T> takes the *first* direct child of that type, and two
; lookups in Scripts/Enemy depend on which one it finds:
;   - EnemyStateMachine._Ready and RainbowChapterBossBehaviour take FindComponent<Sprite2D>() as the
;     body sprite, so Visual must come before any danger readout an inheriting scene adds (an
;     AttackReadout.tscn instance is itself a Sprite2D). Inherited children are appended after these,
;     so authoring Visual second here is what keeps that true.
;   - WrathMiniBoss:211 and RainbowChapterBossBehaviour:383 read
;     FindComponent<CollisionShape2D>()?.Shape as CapsuleShape2D for the body's half-height, so
;     Collider is first and its shape must stay a capsule.
;
; WHAT IS STILL BOUND AT RUNTIME, and why none of it can be baked here: the capsule's radius and
; height (readability per archetype, and the chapter boss's own RainbowChapterBossData.BodySize), the
; visual's size, colour and sorting order, the role marker's caption, colour, font size and sorting
; order, and the health bar's size, offset and colour. All of them come from
; GameplayReadabilityDefaults - already past the World.Ppu boundary - with Resources/Art/
; Readability.json overriding every colour. So each literal below is the shipped *default* an enemy
; nobody dressed would get, not a number the game runs on.
;
; UNITS: 1 Unity metre = 100 px (World.Ppu), +Y down.
[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://Scripts/Combat/Health.cs" id="1"]
[ext_resource type="Script" path="res://Scripts/Combat/DamageReceiver.cs" id="2"]
[ext_resource type="Script" path="res://Scripts/Combat/CombatFeedback.cs" id="3"]
[ext_resource type="Script" path="res://Scripts/Combat/CombatResultBroadcaster.cs" id="4"]
[ext_resource type="Script" path="res://Scripts/Combat/Poise.cs" id="5"]
[ext_resource type="Script" path="res://Scripts/Combat/SoulsWallet.cs" id="6"]
[ext_resource type="Script" path="res://Scripts/Combat/EnemyGroupCombat.cs" id="7"]
[ext_resource type="Script" path="res://Scripts/Gameplay/GameplayWorldHealthBar.cs" id="8"]
[ext_resource type="PackedScene" path="res://Scenes/World/WorldLabel.tscn" id="9"]
[ext_resource type="PackedScene" path="res://Scenes/World/WorldHealthBar.tscn" id="10"]

[sub_resource type="CapsuleShape2D" id="CapsuleShape2D_body"]
; Local to the scene, and this line is load-bearing: without it every enemy in the arena would share
; one CapsuleShape2D and sizing the boss would resize every grunt with it. Same reason
; Scenes/World/SolidBox.tscn marks its rectangle local.
resource_local_to_scene = true
; GameplayReadabilityDefaults.MeleeColliderSize = World.U(0.6, 1.0) = 60 x 100 px. Unity's
; CapsuleCollider2D.size was the full width and height; Godot wants a radius, hence 60 / 2.
; ResizeCapsuleCollider rewrites both from the archetype's own size on every spawn.
radius = 30.0
height = 100.0

[node name="EnemyBase" type="CharacterBody2D"]
; World.Layer.Enemy = 1 << 2 = 4.
collision_layer = 4
; World.Layer.GroundProbe (World 1 << 0 | Ground 1 << 3 = 9) | World.Layer.Player (1 << 1 = 2) = 11.
collision_mask = 11

[node name="Collider" type="CollisionShape2D" parent="."]
shape = SubResource("CapsuleShape2D_body")

[node name="Visual" type="Sprite2D" parent="."]
; No texture here - the archetype scene names its own ActorGrunt / ActorLeaper / ActorCaster /
; ActorBoss png. Every one of them is 64 x 128, so the pivot below is the same for all four.
; GameplayVisualFactory.Pivot(ActorSpriteKind) is (0.5, 0.45) measured from the texture's bottom-left,
; and Dress turned that into ((0.5 - 0.5) * 64, (0.45 - 0.5) * 128) = (0, -6.4). Feet-heavy, not
; centred.
centered = true
offset = Vector2(0, -6.4)
; MeleeVisualSize = World.U(0.88, 1.18) = 88 x 118 px, / the 64 x 128 texture.
scale = Vector2(1.375, 0.921875)
; GameplayReadabilityDefaults.EnemyColor as shipped. Readability.json still wins at runtime.
modulate = Color(0.41960785, 0.22745098, 0.2, 1)
; ActorSortingOrder = 5.
z_index = 5

[node name="Health" type="Node" parent="."]
script = ExtResource("1")

[node name="DamageReceiver" type="Node" parent="."]
script = ExtResource("2")

[node name="CombatFeedback" type="Node2D" parent="."]
script = ExtResource("3")

[node name="CombatResultBroadcaster" type="Node" parent="."]
script = ExtResource("4")

[node name="Poise" type="Node" parent="."]
script = ExtResource("5")

[node name="SoulsWallet" type="Node" parent="."]
script = ExtResource("6")

; Added here rather than left to each archetype's _Ready guard (MeleeGrunt:90, LeapingAttacker:84,
; RangedCaster:99): the guards are "if (FindComponent<EnemyGroupCombat>() == null) AddChild(...)",
; so an authored one satisfies them and nothing is built at runtime any more.
[node name="EnemyGroupCombat" type="Node2D" parent="."]
script = ExtResource("7")

; The word under the enemy's feet saying what it is. CreateRoleMarker binds the caption, the local
; position, the colour, RoleMarkerFontSizePx and RoleMarkerSortingOrder on every instance - the scene
; ships the checkpoint-sign values, which no enemy uses.
[node name="RoleMarker" parent="." instance=ExtResource("9")]
; MeleeRoleLocalPosition = World.V(0, -0.72) = (0, 72). +Y is down, so a Unity -0.72 is below.
position = Vector2(0, 72)

[node name="GameplayWorldHealthBar" type="Node2D" parent="."]
script = ExtResource("8")

; GameplayWorldHealthBar.Build looks for a child named exactly "HealthBar" and only instances this
; scene when it finds none - so an authored bar is the one that gets used. Its size, offset and
; colour are rewritten by ApplyLayout from what AddHealthBar was handed.
[node name="HealthBar" parent="GameplayWorldHealthBar" instance=ExtResource("10")]
; MeleeHealthBarOffset = World.V(0, 0.9) = (0, -90).
position = Vector2(0, -90)
